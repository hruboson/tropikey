# EditorConfig helps maintain consistent coding styles across different editors and IDEs
# See https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C/C++ files - tabs for indentation
[*.{c,cpp,h,hpp,cc,cxx}]
indent_style = tab
indent_size = 4

# CMake files - tabs for indentation
[{CMakeLists.txt,*.cmake}]
indent_style = tab
indent_size = 4

# Shell scripts - tabs
[*.{sh,bash}]
indent_style = tab
indent_size = 4

# Markdown - spaces (more compatible with renderers)
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# JSON/YAML - spaces (standard)
[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

# Lock files
[*.lock]
indent_style = space
indent_size = 2
